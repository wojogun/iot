    {
        "id": "0889793aea6f6ced",
        "type": "ui_template",
        "z": "e418cf23a41a22ec",
        "group": "e564f0026669e056",
        "name": "",
        "order": 5,
        "width": "6",
        "height": "4",
        "format": "<script>\n    (function(scope) {\n    scope.$watch('msg', function(msg) {\n        if (!msg) return;\n\n        // Nur aktualisieren, wenn Songliste ankommt\n        if (Array.isArray(msg.payload)) {\n            scope.songs = msg.payload;\n        }\n    });\n})(scope);\n</script>\n\n<style>\n    .song-grid {\n        display: flex;\n        flex-wrap: wrap;\n        width: 100%;\n    }\n\n    .song-item {\n        width: 50%;\n        /* ← genau 2 pro Zeile */\n        padding: 5px;\n        /* Abstand */\n        box-sizing: border-box;\n    }\n\n    .song-button {\n        width: 100%;\n        /* ← füllt die 50%-Spalte */\n        height: 48px;\n        /* ← gleiche Höhe */\n        white-space: normal;\n        /* Zeilenumbruch für lange Namen */\n    }\n</style>\n\n<div class=\"song-grid\">\n\n    <div class=\"song-item\" ng-repeat=\"song in songs\" ng-if=\"song.id > 0\">\n        <md-button class=\"md-raised song-button\" ng-click=\"send({payload: song.id})\">\n            {{song.name}}\n        </md-button>\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
