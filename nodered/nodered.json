    {
        "id": "6e26917ea22f199d",
        "type": "function",
        "z": "e418cf23a41a22ec",
        "name": "bookParty",
        "func": "// aus der util-function\nconst toTimestamp = flow.get('toTimestamp');\nconst formatLocal = flow.get('formatLocal');\nif (typeof toTimestamp !== 'function' || typeof formatLocal !== 'function') {\n    node.error(\"Utils nicht initialisiert\");\n    return msg;\n}\n\n// Rohwert holen\nlet raw = flow.get('partyDateTimeString');\nconst bookingTs = toTimestamp(raw);\nif (!bookingTs) {\n    msg.payload = \"Ungültige oder leere Datum/Zeit-Eingabe.\";\n    return msg;\n}\n\nflow.set(\"partyBookingTs\", bookingTs);\nflow.set(\"partyTriggered\", false);\n\n//msg.payload = \"Party gebucht für: \" + dt.toLocaleString();\nmsg.payload = formatLocal(bookingTs);\n\nconst msgMqtt = {\n    topic: \"resort/house3/party/next\",\n    payload: formatLocal(bookingTs)\n};\n\nreturn [msg, msgMqtt];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 420,
        "wires": [
            [
                "ac08162c3a7a09fb",
                "f191207527f28720",
                "bd45afae07cf9e87"
            ]
        ]
    },
    {
        "id": "44bbc3f2f254801c",
        "type": "inject",
        "z": "e418cf23a41a22ec",
        "name": "cron",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "10",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "iso",
        "payloadType": "date",
        "x": 90,
        "y": 340,
        "wires": [
            [
                "2ec6d6320977fdfd"
            ]
        ]
    },
    {
        "id": "2ec6d6320977fdfd",
        "type": "function",
        "z": "e418cf23a41a22ec",
        "name": "cronFunction",
        "func": "const formatLocal = flow.get('formatLocal');\nconst bookingTs = flow.get('partyBookingTs');\nconst triggered = flow.get('partyTriggered') || false;\n\nif (!bookingTs || triggered) return null;\n\nconst now = Date.now();\nconst windowMs = 1 * 60 * 1000; // Toleranzfenster, z.B. 1 Minuten nach Buchungszeit\n\n// Debug, um zu sehen was passiert\nnode.log(\"Check booking: now=\" + now + \" bookingTs=\" + bookingTs);\n\n// Liegen wir im Zeitfenster?\nif (now >= bookingTs && now <= bookingTs + windowMs) {\n    flow.set('partyTriggered', true);\n\n    // Nachricht an Haus 3 -> Party START\n    const outMqtt = {\n        topic: \"resort/house3/party/cmd\",\n        payload: \"START\"\n    };\n\n    // Status fürs Dashboard\n    const outStatus = {\n        payload: \"Party automatisch gestartet um \" + formatLocal(bookingTs)\n    };\n\n    return [outMqtt, outStatus];\n}\n\n// Noch zu früh oder schon vorbei\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 340,
        "wires": [
            [
                "f191207527f28720"
            ]
        ]
    },
